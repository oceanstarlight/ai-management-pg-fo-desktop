{
  "rules": {
    "relays": {
      "$token": {
        ".write": "auth != null && data.child('owner').val() === auth.uid && !newData.exists()",
        "owner": {
          ".read": "auth != null && data.val() === auth.uid",
          ".write": "auth != null && $token.matches(/^[0-9a-f]{64}$/) && (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid)"
        },
        "events": {
          ".read": "auth != null && root.child('relays').child($token).child('owner').val() === auth.uid",
          "$id": {
            ".write": "(!data.exists() && newData.exists() && root.child('relays').child($token).child('owner').exists()) || (!newData.exists() && auth != null && root.child('relays').child($token).child('owner').val() === auth.uid)",
            ".validate": "newData.hasChildren(['kind', 'session', 'at'])",
            "kind": {
              ".validate": "newData.isString() && newData.val().matches(/^(prompt|answer|tool|toolEnd)$/)"
            },
            "session": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "repo": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "branch": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "at": { ".validate": "newData.isNumber()" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 20000" },
            "id": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "tool": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "target": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "detail": { ".validate": "newData.isString() && newData.val().length <= 400" },
            "agent": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "added": { ".validate": "newData.isNumber()" },
            "removed": { ".validate": "newData.isNumber()" },
            "ok": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "context": {
          "$repo": {
            ".read": true,
            ".write": "auth != null && root.child('relays').child($token).child('owner').val() === auth.uid",
            ".validate": "newData.hasChildren(['text', 'updatedAt'])",
            "text": { ".validate": "newData.isString() && newData.val().length <= 8000" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "$other": { ".read": false, ".write": false }
  }
}
