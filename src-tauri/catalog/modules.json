    "modules": [
      "repomix",
      "ast-grep",
      "mcp-mermaid"
    ],
    "combos": [
      {
        "name": {
          "ko": "코드베이스 지도",
          "en": "Codebase map"
        },
        "goal": {
          "ko": "저장소 전체를 읽고 구조와 흐름을 다이어그램으로 정리한다",
          "en": "Read the whole repository and lay out its structure and flow as diagrams"
        },
        "members": [
          {
            "module": "repomix",
            "role": {
              "ko": "저장소를 묶어 모듈·의존 관계를 파악한다",
              "en": "Pack the repository and work out its modules and dependencies"
            }
          },
          {
            "module": "mcp-mermaid",
            "role": {
              "ko": "파악한 구조를 Mermaid 다이어그램으로 그린다",
              "en": "Draw what was found as Mermaid diagrams"
            }
          }
        ]
      },
      {
        "name": {
          "ko": "구조 기반 리팩터링",
          "en": "Structural refactor"
        },
        "goal": {
          "ko": "바꿀 패턴의 영향 범위를 파악하고, 같은 패턴을 구조 검색으로 찾아 한꺼번에 고친다",
          "en": "Find where a pattern is used, then rewrite every match by structure in one go"
        },
        "members": [
          {
            "module": "repomix",
            "role": {
              "ko": "관련 코드를 묶어 영향 범위를 확인한다",
              "en": "Pack the related code and check what the change touches"
            }
          },
          {
            "module": "ast-grep",
            "role": {
              "ko": "패턴을 찾아 미리 보고(--json) 한꺼번에 바꾼다",
              "en": "Find the pattern, preview (--json) and rewrite it everywhere"
            }
          }
        ]
      }
    ]
  }
}